<IfModule mod_rewrite.c>
    RewriteEngine On
    # Keep Laravel private directories out of direct web access.
    RewriteRule ^(?:app|bootstrap|config|database|resources|routes|storage|tests|vendor|node_modules|\.git)(?:/|$) - [F,L,NC]
    RewriteRule ^(?:\.env(?:\..*)?|artisan|composer\.(?:json|lock)|package(?:-lock)?\.json|vite\.config\.js|phpunit\.xml|README\.md)$ - [F,L,NC]
    # Route requests through Laravel's public directory.
    RewriteRule ^$ public/ [L]
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
<FilesMatch "^(?:\.env.*|\.htaccess|\.gitignore)$">
    Require all denied
</FilesMatch>
Options -Indexes
